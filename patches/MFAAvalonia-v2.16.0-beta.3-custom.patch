--- /dev/null
+++ b/MFAAvalonia/Helper/TaskScheduleHelper.cs
@@ -0,0 +1,67 @@
+using MFAAvalonia.Extensions.MaaFW;
+using System;
+using System.Globalization;
+using System.Linq;
+
+namespace MFAAvalonia.Helper;
+
+internal static class TaskScheduleHelper
+{
+    public const string OptionName = "MFA_NEXT_RUN_AT";
+    public const string InputName = "value";
+    public const string DisplayFormat = "yyyy-MM-dd HH:mm:ss";
+
+    private static readonly string[] AcceptedFormats =
+    [
+        DisplayFormat,
+        "yyyy-MM-dd HH:mm",
+        "yyyy-MM-dd"
+    ];
+
+    public static bool TryGetNextRunAt(MaaInterface.MaaInterfaceTask? task, out DateTime nextRunAt)
+    {
+        nextRunAt = default;
+        var option = task?.Option?.FirstOrDefault(item =>
+            string.Equals(item.Name, OptionName, StringComparison.Ordinal));
+        if (option?.Data == null
+            || !option.Data.TryGetValue(InputName, out var value)
+            || string.IsNullOrWhiteSpace(value))
+        {
+            return false;
+        }
+
+        return DateTime.TryParseExact(
+            value.Trim(),
+            AcceptedFormats,
+            CultureInfo.InvariantCulture,
+            DateTimeStyles.AllowWhiteSpaces | DateTimeStyles.AssumeLocal,
+            out nextRunAt);
+    }
+
+    public static bool IsDue(MaaInterface.MaaInterfaceTask? task, DateTime now, out DateTime nextRunAt)
+    {
+        return !TryGetNextRunAt(task, out nextRunAt) || nextRunAt <= now;
+    }
+
+    public static bool SetNextMonday(MaaInterface.MaaInterfaceTask? task, DateTime now, out DateTime nextRunAt)
+    {
+        nextRunAt = default;
+        var option = task?.Option?.FirstOrDefault(item =>
+            string.Equals(item.Name, OptionName, StringComparison.Ordinal));
+        if (option == null)
+        {
+            return false;
+        }
+
+        var daysUntilMonday = ((int)DayOfWeek.Monday - (int)now.DayOfWeek + 7) % 7;
+        if (daysUntilMonday == 0)
+        {
+            daysUntilMonday = 7;
+        }
+
+        nextRunAt = now.Date.AddDays(daysUntilMonday);
+        option.Data ??= [];
+        option.Data[InputName] = nextRunAt.ToString(DisplayFormat, CultureInfo.InvariantCulture);
+        return true;
+    }
+}
