                 item.RunElapsed = TimeSpan.Zero;
                 item.RunStartedAt = null;
@@ -199,7 +200,41 @@ public partial class TaskQueueViewModel : ViewModelBase, IDisposable
 
     public void MarkTaskSucceeded(DragItemViewModel? item, long runId)
     {
-        CompleteTaskRun(item, runId, TaskRunState.Succeeded, null);
+        UpdateTaskRunState(item, runId, task =>
+        {
+            CompleteTaskRunCore(task, TaskRunState.Succeeded, null);
+            ScheduleNextRunIfCompleted(task);
+            StopTaskRunElapsedTimerIfIdle();
+        });
+    }
+
+    private void ScheduleNextRunIfCompleted(DragItemViewModel task)
+    {
+        if (!task.ScheduleCompletionSignaled)
+        {
+            return;
+        }
+
+        task.ScheduleCompletionSignaled = false;
+        if (!TaskScheduleHelper.SetNextMonday(task.InterfaceItem, DateTime.Now, out var nextRunAt))
+        {
+            return;
+        }
+
+        Processor.InstanceConfiguration.SetValue(
+            ConfigurationKeys.TaskItems,
+            TaskItemViewModels
+                .Where(model => !model.IsResourceOptionItem)
+                .Select(model => model.InterfaceItem)
+                .ToList());
+        LoggerHelper.Info($"任务已全部完成，下次执行时间已设置为：{nextRunAt:yyyy-MM-dd HH:mm:ss}，任务={task.Name}");
+
+        // 任务选项是命令式生成的；若设置面板正打开，重建一次以立即显示新时间。
+        if (task.EnableSetting)
+        {
+            task.EnableSetting = false;
+            task.EnableSetting = true;
+        }
     }
 
     public void MarkTaskFailed(DragItemViewModel? item, long runId, string? errorMessage = null)

