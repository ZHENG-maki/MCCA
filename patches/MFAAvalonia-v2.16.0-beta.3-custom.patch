@@ -0,0 +1,31 @@
+using MaaFramework.Binding;
+using MaaFramework.Binding.Custom;
+using MFAAvalonia.Helper;
+using System;
+
+namespace MFAAvalonia.Extensions.MaaFW.Custom;
+
+public sealed class TaskScheduleCompletionAction(Action onCompleted) : IMaaCustomAction
+{
+    public string Name { get; set; } = nameof(TaskScheduleCompletionAction);
+
+    public bool Run<T>(T context, in RunArgs args, in RunResults results) where T : IMaaContext
+    {
+        try
+        {
+            ActionParamHelper.ThrowIfStopping(context);
+            onCompleted();
+            LoggerHelper.Info("[TaskScheduleCompletionAction] 已确认任务目标全部完成。");
+            return true;
+        }
+        catch (MaaStopException)
+        {
+            return false;
+        }
+        catch (Exception exception)
+        {
+            LoggerHelper.Error($"[TaskScheduleCompletionAction] Error: {exception.Message}");
+            return false;
+        }
+    }
+}
