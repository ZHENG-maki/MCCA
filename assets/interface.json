{
    "name": "MCCA",
    "url": "https://github.com/MaaXYZ/MCCA",
    "mirrorchyan_rid": "MCCA",
    "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "ADB 默认方式",
            "type": "Adb"
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "{PROJECT_DIR}/resource/base"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "{PROJECT_DIR}/resource/base",
                "{PROJECT_DIR}/resource/bilibili"
            ]
        }
    ],
    "task": [
        {
            "name": "启动游戏",
            "entry": "进入首页",
            "check": true,
            "doc": "无"
        },
        {
            "name": "活动",
            "entry": "活动_入口",
            "check": true,
            "doc": "[color:red]活动功能暂时只有困难最后一关，且版本更新后未必能继续使用[/color]"
        },
        {
            "name": "每日免费礼包",
            "entry": "Shopping",
            "check": true,
            "doc": "无"
        },
        {
            "name": "限时贸易所购买",
            "entry": "Time-limited Shopping",
            "check": true,
            "doc": "每次最多购买 1 件：优先购买 -30% 折扣商品；没有可购买的 -30% 商品时购买左上角第一个有库存商品；不会自动刷新商店。"
        },
        {
            "name": "万物贸易所",
            "entry": "万物贸易所",
            "check": false,
            "doc": "进入万物贸易所的异星灰域，并按多选清单自动购买；购买时选择最大数量，余额不足的商品自动跳过。任务成功执行后，下次执行时间自动设为下周一。",
            "option": [
                "MFA_NEXT_RUN_AT",
                "贸易区域"
            ]
        },
        {
            "name": "模拟军演",
            "entry": "模拟军演",
            "check": true,
            "doc": "优先判断第一个对手战力：达到阈值时刷新，否则固定挑战第一个对手；自动开启自动战斗和三倍速；刷新次数或挑战次数耗尽时安全结束，不购买次数。",
            "option": [
                "刷新战力阈值"
            ],
            "pipeline_override": {
                "首页_出击": {
                    "post_delay": 3000,
                    "timeout": 20000,
                    "next": "模拟军演_入口"
                }
            }
        },
        {
            "name": "基建",
            "entry": "Infrastructures",
            "doc": "可能会有bug",
            "option": [
                "是否访问每个好友换抽"
            ]
        },
        {
            "name": "每日探索",
            "entry": "出击任务列表",
            "option": [
                "关卡选择",
                "第几层",
                "是否手动选择次数(开启燃料使用)",
                "手动次数"
            ]
        },
        {
            "name": "周本",
            "entry": "WeekInstance",
            "pipeline_override": {
                "首页_出击": {
                    "next": "ActivityExploration"
                }
            },
            "option": [
                "周本关卡选择"
            ]
        },
        {
            "name": "领取奖励(邮箱+每日+通行证)",
            "entry": "Awards",
            "check": true,
            "doc": "无"
        },
        {
            "name": "关闭游戏",
            "entry": "关闭游戏"
        },
        {
            "name": "历战试炼",
            "entry": "历战试炼",
            "check": true,
            "doc": "测试中,暂时仅支持打限时boss，任务目标达到10为高进度，将不会继续任务；[color:red]开启该任务需自行配置有足够强度的队伍[/color]",
            "pipeline_override": {
                "活动选择": {
                    "expected": "历战试炼",
                    "next": "历战试炼-关卡选择"
                }
            },
            "option": [
                "是否打挑战难度",
                "挑战难度选择"
            ]
        }
    ],
